# Production VPS defaults (recommended)
TRAEFIK_MODE=prod
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_HOST=127.0.0.1
TRAEFIK_DASHBOARD_PORT=8080

# Traefik runtime security defaults
TRAEFIK_API_INSECURE=false
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_INSECURE_SKIP_VERIFY=false

# Local development override example:
# TRAEFIK_MODE=dev
# TRAEFIK_API_INSECURE=true
# TRAEFIK_LOG_LEVEL=DEBUG
# TRAEFIK_INSECURE_SKIP_VERIFY=true
# TRAEFIK_DASHBOARD_HOST=0.0.0.0
# TRAEFIK_DASHBOARD_PORT=8080
